    "./README.md": "./README.md"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
