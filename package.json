    "@deepseek-ai/dsh-credentials": "0.2.2-rc.2",
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaveBird/dsh-web-search-workbuddy.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web-search",
